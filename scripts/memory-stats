#!/usr/bin/env bash

# MEMORY_OOMD_ROOT (default /) is prepended to /proc and /sys paths and
# MEMORY_OOMD_UID overrides the uid used to find the user's app.slice cgroup,
# so tests can feed fixture trees.

set -u
export LC_ALL=C

root=${MEMORY_OOMD_ROOT:-}
root=${root%/}
uid=${MEMORY_OOMD_UID:-$UID}
app_slice="$root/sys/fs/cgroup/user.slice/user-$uid.slice/user@$uid.service/app.slice"

# Only pass files that exist, so a fixture or kernel without one still works.
files=()
for f in "$root/proc/meminfo" "$root/proc/pressure/memory"; do
  [[ -r $f ]] && files+=("$f")
done
app_psi=""
[[ -r $app_slice/memory.pressure ]] && app_psi="$app_slice/memory.pressure" && files+=("$app_psi")

sampled_ms=$(date +%s%3N)

awk -v sampled_ms="$sampled_ms" \
  -v f_meminfo="$root/proc/meminfo" -v f_psi="$root/proc/pressure/memory" \
  -v f_app="$app_psi" '
  FILENAME == f_meminfo {
    value = $2 * 1024
    if ($1 == "MemTotal:") total = value
    else if ($1 == "MemFree:") free = value
    else if ($1 == "MemAvailable:") available = value
    else if ($1 == "Cached:") cached = value
    else if ($1 == "SReclaimable:") reclaimable = value
    else if ($1 == "Shmem:") shared = value
    else if ($1 == "AnonPages:") anonymous = value
    else if ($1 == "SwapTotal:") swap_total = value
    else if ($1 == "SwapFree:") swap_free = value
    next
  }

  # System-wide PSI: "some" and "full" avg10.
  FILENAME == f_psi && ($1 == "some" || $1 == "full") {
    for (field = 2; field <= NF; field++) {
      if ($field ~ /^avg10=/) {
        split($field, pair, "=")
        if ($1 == "some") pressure = pair[2] + 0
        else pressure_full = pair[2] + 0
      }
    }
    next
  }

  # The monitored cgroup: systemd-oomd compares its "full" avg10 to the limit.
  FILENAME == f_app && ($1 == "some" || $1 == "full") {
    app_available = 1
    for (field = 2; field <= NF; field++) {
      if ($field ~ /^avg10=/) {
        split($field, pair, "=")
        if ($1 == "some") app_some = pair[2] + 0
        else app_full = pair[2] + 0
      }
    }
    next
  }

  END {
    if (total <= 0) exit 1
    if (available < 0) available = 0
    if (available > total) available = total

    used = total - available
    app = anonymous + shared
    cache = cached + reclaimable - shared
    if (cache < 0) cache = 0
    kernel = total - free - app - cache
    if (kernel < 0) {
      cache += kernel
      kernel = 0
      if (cache < 0) cache = 0
    }

    swap_used = swap_total - swap_free
    if (swap_used < 0) swap_used = 0
    if (pressure < 0) pressure = 0
    if (pressure > 100) pressure = 100
    if (pressure_full < 0) pressure_full = 0
    if (pressure_full > 100) pressure_full = 100
    swap_percent = swap_total > 0 ? swap_used * 100 / swap_total : 0
    if (swap_percent > 100) swap_percent = 100

    printf "{"
    printf "\"sampledMs\":%.0f,", sampled_ms
    printf "\"totalBytes\":%.0f,", total
    printf "\"usedBytes\":%.0f,", used
    printf "\"availableBytes\":%.0f,", available
    printf "\"appBytes\":%.0f,", app
    printf "\"kernelBytes\":%.0f,", kernel
    printf "\"cacheBytes\":%.0f,", cache
    printf "\"freeBytes\":%.0f,", free
    printf "\"swapTotalBytes\":%.0f,", swap_total
    printf "\"swapUsedBytes\":%.0f,", swap_used
    printf "\"swapUsedPercent\":%.2f,", swap_percent
    printf "\"pressurePercent\":%.2f,", pressure
    printf "\"pressureFullPercent\":%.2f,", pressure_full
    printf "\"appSlicePressureAvailable\":%s,", app_available ? "true" : "false"
    printf "\"appSlicePressureSomeAvg10\":%.2f,", app_some
    printf "\"appSlicePressureFullAvg10\":%.2f", app_full
    printf "}\n"
  }
' "${files[@]}"
