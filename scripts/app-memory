#!/usr/bin/env bash
# Per-app memory for the cgroups under the user's app.slice, as JSON.
#
# Usage: app-memory [--top N]
#
# Every app scope or service at depth 1 and 2 under app.slice is one unit
# (app-graphical.slice and similar containers are entered, never listed).
# app-dbus-* slices and plain services are skipped unless large. Units that
# resolve to the same readable name are summed. The list is sorted by RAM plus
# swap, largest first, and cut to the top N.
#
# MEMORY_OOMD_ROOT (default /) is prepended to /proc and /sys paths,
# MEMORY_OOMD_UID overrides the uid, and MEMORY_OOMD_MIN_BYTES (default
# 104857600) is the size a dbus slice or plain service needs to be listed.

set -u
export LC_ALL=C

top=8
while (( $# > 0 )); do
  case $1 in
    --top) top=${2:-8}; shift 2 ;;
    --top=*) top=${1#--top=}; shift ;;
    *) shift ;;
  esac
done
[[ $top =~ ^[0-9]+$ ]] || top=8

root=${MEMORY_OOMD_ROOT:-}
root=${root%/}
uid=${MEMORY_OOMD_UID:-$UID}
min_bytes=${MEMORY_OOMD_MIN_BYTES:-104857600}
app_slice="$root/sys/fs/cgroup/user.slice/user-$uid.slice/user@$uid.service/app.slice"

sampled_ms=$(date +%s%3N)

if [[ ! -d $app_slice ]]; then
  jq -cn --argjson ms "$sampled_ms" \
    '{sampledMs: $ms, available: false, omitKnown: false, appCount: 0, maxPressure: null, apps: []}'
  exit 0
fi

# Terminal emulators and shells never name a terminal scope; short-lived
# pipeline helpers do not either. These win over everything else in this order.
preferred=(claude codex opencode gemini aider nvim vim vi emacs hx nano helix btop htop ssh mosh python python3 node cargo make npm pnpm go)
ignored=" foot footclient alacritty kitty ghostty wezterm wezterm-gui konsole xterm gnome-terminal- xdg-terminal-exec uwsm-app bash zsh fish sh dash nu tmux: tmux xdg-open sleep cat sort head tail uniq grep awk sed ls less jq watch sudo env "

declare -A browsers=( [brave]=Brave [chromium]=Chromium [chrome]=Chrome [google-chrome]=Chrome [google-chrome-stable]=Chrome [firefox]=Firefox [vivaldi-bin]=Vivaldi [opera]=Opera [microsoft-edge]=Edge )
launchers=" gtk-launch uwsm-app xdg-open systemd-run app2unit "
terminals=" xdg-terminal-exec alacritty kitty foot footclient ghostty wezterm konsole xterm gnome-terminal "

# read_num <file> <var>: first token of a file, "" if missing, unreadable or "max".
read_num() {
  local _v=""
  read -r _v < "$1" 2>/dev/null || _v=""
  [[ $_v =~ ^[0-9]+$ ]] || _v=""
  printf -v "$2" '%s' "$_v"
}

# read_psi <memory.pressure> : sets psi_some / psi_full (avg10, or "").
read_psi() {
  local kind a rest
  psi_some="" psi_full=""
  [[ -r $1 ]] || return 0
  while read -r kind a rest; do
    [[ $a == avg10=* ]] || continue
    if [[ $kind == some ]]; then psi_some=${a#avg10=}; elif [[ $kind == full ]]; then psi_full=${a#avg10=}; fi
  done < "$1" 2>/dev/null
}

# child_name <cgroup dir> <kind>: a readable name from the processes inside.
#   terminal -> "terminal (<comm>)"
#   browser  -> the browser name, "" if no browser process is inside
#   launcher -> the browser name, else the comm of the largest process, "" if none
child_name() {
  local dir=$1 kind=$2 pid comm count=0 rss best_comm="" best_rss=-1 shell_comm="" pref_comm="" pref_rank=999 browser="" i
  while read -r pid; do
    (( ++count > 300 )) && break
    [[ -r $root/proc/$pid/comm ]] || continue
    read -r comm < "$root/proc/$pid/comm" 2>/dev/null || continue
    [[ -n $comm ]] || continue
    if [[ $kind != terminal ]]; then
      if [[ -n ${browsers[$comm]:-} ]]; then browser=${browsers[$comm]}; break; fi
      [[ $kind == browser ]] && continue
    else
      for i in "${!preferred[@]}"; do
        if [[ ${preferred[$i]} == "$comm" ]]; then
          (( i < pref_rank )) && { pref_rank=$i; pref_comm=$comm; }
          continue 2
        fi
      done
    fi
    if [[ $ignored == *" $comm "* ]]; then
      [[ -z $shell_comm && $comm =~ ^(bash|zsh|fish|sh|dash|nu)$ ]] && shell_comm=$comm
      continue
    fi
    rss=0
    [[ -r $root/proc/$pid/statm ]] && { read -r _ rss _ < "$root/proc/$pid/statm" 2>/dev/null || rss=0; }
    [[ $rss =~ ^[0-9]+$ ]] || rss=0
    if (( rss > best_rss )); then
      best_rss=$rss; best_comm=$comm
    fi
  done < "$dir/cgroup.procs" 2>/dev/null
  if [[ $kind != terminal ]]; then
    CHILD_NAME=${browser:-$best_comm}
  elif [[ -n $pref_comm ]]; then
    CHILD_NAME="terminal ($pref_comm)"
  elif [[ -n $best_comm ]]; then
    CHILD_NAME="terminal ($best_comm)"
  elif [[ -n $shell_comm ]]; then
    CHILD_NAME="terminal ($shell_comm)"
  else
    CHILD_NAME="terminal"
  fi
}

# unit_name <cgroup dir name>: sets NAME and KIND (terminal, browser, launcher, app, service).
unit_name() {
  local base=$1 stem rest appid parts n lower
  stem=${base%.*}
  KIND=service
  if [[ $stem == app-* ]]; then
    KIND=app
    rest=${stem#app-}
    IFS=- read -ra parts <<< "$rest"
    n=${#parts[@]}
    if (( n >= 3 )); then
      appid=${parts[1]}                 # app-<launcher>-<appid>-<random>
    elif (( n == 2 )); then
      if [[ ${parts[1]} =~ ^[0-9a-fA-F]+$ ]]; then appid=${parts[0]}; else appid=${parts[1]}; fi
    else
      appid=${parts[0]}
    fi
    appid=${appid%%@*}
  else
    appid=$stem
  fi
  printf -v appid '%b' "$appid"
  appid=${appid#dbus-:*-}               # app-dbus\x2d:1.42\x2dorg.gnome.Nautilus.slice
  appid=${appid%.desktop}
  if [[ $appid =~ ^(org|com|io|net|dev|app|de|fr|me)\.[A-Za-z0-9_-]+\..+$ ]]; then
    appid=${appid##*.}
  fi
  [[ -n $appid ]] || appid=$stem
  lower=${appid,,}
  NAME=$appid
  if [[ $KIND == app ]]; then
    if [[ $terminals == *" $lower "* ]]; then KIND=terminal; fi
    if [[ $launchers == *" $lower "* ]]; then KIND=launcher; fi
    [[ $lower == chromium || $lower == chrome || $lower == google-chrome || -n ${browsers[$lower]:-} ]] && KIND=browser
  fi
}

units=()
for child in "$app_slice"/*/; do
  child=${child%/}
  [[ -d $child ]] || continue
  base=${child##*/}
  case $base in
    *.scope|*.service) units+=("$child") ;;
    app-dbus*.slice) units+=("$child") ;;
    *.slice) for grand in "$child"/*/; do grand=${grand%/}; [[ -d $grand ]] && units+=("$grand"); done ;;
  esac
done

# One getfattr run for the whole list: user.oomd_omit marks cgroups that
# systemd-oomd must never kill (ManagedOOMPreference=omit).
omit_known=false
declare -A omitted=()
if command -v getfattr >/dev/null 2>&1 && (( ${#units[@]} > 0 )); then
  omit_known=true
  while IFS= read -r line; do
    if [[ $line == "# file: "* ]]; then
      cur=${line#"# file: "}
      printf -v cur '%b' "${cur//\\/\\0}"       # getfattr writes \134 for a backslash
      cur=/${cur#/}
    elif [[ $line == user.oomd_omit=* && -n ${cur:-} ]]; then
      omitted[$cur]=1
    fi
  done < <(getfattr -n user.oomd_omit --absolute-names -- "${units[@]}" 2>/dev/null)
fi

rows=$(
  for dir in "${units[@]}"; do
    base=${dir##*/}
    read_num "$dir/memory.current" mem
    [[ -n $mem ]] || continue
    read_num "$dir/memory.swap.current" swap
    swap=${swap:-0}
    # dbus slices and plain services are noise unless large.
    unit_name "$base"
    if [[ $KIND == service || $base == app-dbus* ]]; then
      (( mem + swap >= min_bytes )) || continue
    fi
    name=$NAME
    if [[ $KIND == terminal ]]; then
      child_name "$dir" terminal; name=$CHILD_NAME
    elif [[ $KIND == browser || $KIND == launcher ]]; then
      child_name "$dir" "$KIND"; [[ -n $CHILD_NAME ]] && name=$CHILD_NAME
    fi
    read_num "$dir/memory.max" max
    read_num "$dir/memory.high" high
    read_num "$dir/memory.swap.max" swap_max
    read_psi "$dir/memory.pressure"
    key=${dir#"$root"}
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$name" "$mem" "$swap" "$max" "$high" "$swap_max" "$psi_some" "$psi_full" \
      "${omitted[$dir]:+1}" "$base"
  done
)

printf '%s' "$rows" | jq -Rn --argjson ms "$sampled_ms" --argjson top "$top" --argjson omit_known "$omit_known" '
  def num: if . == "" then null else tonumber end;
  def pct($used; $cap): if $cap != null and $cap > 0 then ($used * 100 / $cap) else null end;
  [inputs | select(length > 0) | split("\t") | {
    name: .[0], mem: (.[1] | tonumber), swap: (.[2] | tonumber),
    max: (.[3] | num), high: (.[4] | num), swapMax: (.[5] | num),
    some: (.[6] | num), full: (.[7] | num), omit: (.[8] == "1"), unit: .[9]
  }] as $units
  | ($units | group_by(.name) | map(
      . as $g
      | ([$g[] | select(.max != null) | {u: ., p: pct(.mem; .max)}] | max_by(.p)) as $capped
      | ([$g[] | select(.swapMax != null) | {u: ., p: pct(.swap; .swapMax)}] | max_by(.p)) as $swapCapped
      | {
          name: $g[0].name,
          unitCount: ($g | length),
          ramBytes: ($g | map(.mem) | add),
          swapBytes: ($g | map(.swap) | add),
          totalBytes: ($g | map(.mem + .swap) | add),
          capBytes: ($capped.u.max // null),
          highBytes: ([$g[] | .high | select(. != null)] | max),
          capPercent: ($capped.p // null),
          swapCapBytes: ($swapCapped.u.swapMax // null),
          swapCapPercent: ($swapCapped.p // null),
          pressureSomeAvg10: ([$g[] | .some | select(. != null)] | max),
          pressureFullAvg10: ([$g[] | .full | select(. != null)] | max),
          oomdOmit: ($g | all(.omit))
        }
    )) as $apps
  | ($apps | sort_by(-.totalBytes, .name)) as $sorted
  | ($apps | map(select(.pressureFullAvg10 != null)) | max_by(.pressureFullAvg10)) as $worst
  | {
      sampledMs: $ms,
      available: true,
      omitKnown: $omit_known,
      appCount: ($sorted | length),
      maxPressure: (if $worst == null then null else {
        name: $worst.name, fullAvg10: $worst.pressureFullAvg10, someAvg10: ($worst.pressureSomeAvg10 // 0)
      } end),
      apps: $sorted[0:$top]
    }'
